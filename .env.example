DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter（LLM / TTS / 图片 共用一个 key）
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
OPENROUTER_EXTRACT_MODEL=deepseek/deepseek-chat
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Cloudflare R2（S3 兼容）
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Memory（留空 → LocalMemoryService）
MEM0_API_KEY=

# Cloudflare Turnstile（注册人机验证）
# 去 https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend（欢迎邮件 + 每日情话）
# 去 https://resend.com 获取 API key；FROM 需要是你在 Resend 验证过的域名邮箱
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@你的域名.com

# Cron 鉴权密钥（防止 /api/cron/* 被随意调用）
# 生成：openssl rand -hex 32
CRON_SECRET=
